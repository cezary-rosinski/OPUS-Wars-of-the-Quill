<https://opus-project.eu/letter/Smith1_letter_111> a opus:LetterManifestation,
        schema:CreativeWork ;
    dcterms:abstract "Henry Wotton writes from Venice on 12 October 1607 to Robert Cecil, Earl of Salisbury, reporting on the recent attempted assassination of the Venetian theologian Paolo Sarpi. He encloses the formal sentence passed by the Venetian Council of Ten on the offenders and describes the widespread outrage, including the Venetian government’s intense pursuit of the culprits and its special care for Sarpi’s recovery. Wotton highlights the political ramifications, including suspicions that Rome—the Pope or his agents—was behind the attack. He also notes that the Papal Nuncio in Venice is in both physical and mental distress, possibly from fear of repercussions. Wotton concludes with an update on Sarpi’s condition and reflects on the event as an instance of “God’s miraculous Providence.”" ;
    bibo:edition "Pearsall Smith 1907, pp. 506-509" ;
    skos:note "letter_19 in the old chart (Wotton_Jes_Letters)" ;
    opus:authorAsMarked "Henry Wotton" ;
    opus:dateAsMarked "12th of October, 1607." ;
    opus:dateIsUncertain true ;
    opus:destination [ opus:certainty "inferred" ;
            opus:value <https://opus-project.eu/place/place_4> ] ;
    opus:destinationAsMarked "London" ;
    opus:incipit "Having lately troubled your Lordship" ;
    opus:originAsMarked "Venice" ;
    opus:recipient [ opus:certainty "certain" ;
            opus:value <https://opus-project.eu/person/person_199> ] ;
    opus:recipientAsMarked "Earl of Salisbury" ;
    schema:author [ opus:certainty "certain" ;
            opus:value <https://opus-project.eu/person/person_110> ] ;
    schema:dateCreated "1607-10-12"^^xsd:date ;
