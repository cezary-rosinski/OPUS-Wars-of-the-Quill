<https://opus-project.eu/letter/Smith1_letter_33> a opus:LetterManifestation,
        schema:CreativeWork ;
    dcterms:abstract "Henry Wotton writes from Sienna to Lord Zouche, discussing encrypted correspondence and intercepted letters. He informs Zouche of two books published in Italy against the Lord Treasurer, allegedly connected to a Catholic network involving English contacts. He also describes his recent interactions with Cardinal Robert Bellarmine and his hesitancy about revealing their conversation. Additionally, he comments on European political affairs, including a potential marriage alliance between the Medici and Bavaria, and notes the presence of Jesuits at the courts of Bavarian princes." ;
    dcterms:subject <https://opus-project.eu/keyword/codenames>,
        <https://opus-project.eu/keyword/espionage>,
        <https://opus-project.eu/keyword/international_politics> ;
    bibo:edition "Pearsall Smith 1907, pp. 353-356" ;
    skos:note "letter_60 in the old chart (Wotton_Jes_Letters)" ;
    opus:authorAsMarked "H. W." ;
    opus:dateAsMarked "third of December, 1592." ;
    opus:dateIsUncertain true ;
