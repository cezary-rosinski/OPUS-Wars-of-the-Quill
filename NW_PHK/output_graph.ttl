<https://opus-project.eu/letter/Smith1_letter_177> a opus:LetterManifestation,
        schema:CreativeWork ;
    dcterms:abstract "This letter, written by Sir Henry Wotton to King James I on January 21, 1610, describes how Henry IV of France attempted to undermine Protestant activities in Venice by using an intercepted letter to expose covert Protestant networks. Giovanni Diodati, an Italian Protestant theologian from Geneva, had written to a French official about Protestant affairs in Venice. Somehow, the letter fell into the hands of the Jesuit Father Pierre Cotton, Henry IV’s confessor, who then showed it to the French king. Henry IV forwarded copies to the Pope and the French ambassador in Venice, who delayed its presentation for strategic reasons, possibly waiting for Papalist factions in the Venetian Senate to prepare the ground. Wotton interprets these actions as part of a broader French effort to curry favor with Rome, possibly as preparation for a future alliance or to facilitate the return of the Jesuits to Venice. Wotton also notes a subtle but significant pressure campaign directed at Paolo Sarpi, urging him to seek papal absolution. The letter reflects England’s diplomatic interest in countering Catholic influence in Venice and maintaining its Protestant allies." ;
    bibo:edition "Pearsall Smith 1907, pp. 613-617" ;
    skos:note "letter_46 in the old chart (Wotton_Jes_Letters)" ;
    opus:dateAsMarked "the 21th of January 1609⟨10⟩. Style of the place" ;
    opus:dateIsInferred true ;
    opus:destination [ opus:certainty "inferred" ;
            opus:value <https://opus-project.eu/place/place_4> ] ;
    opus:destinationAsMarked "London" ;
    opus:incipit "I present herein unto your Majesty" ;
    opus:originAsMarked "Venice" ;
    opus:recipient [ opus:certainty "certain" ;
            opus:value <https://opus-project.eu/person/person_119> ] ;
    opus:recipientAsMarked "James I" ;
    schema:author [ opus:certainty "inferred" ;
            opus:value <https://opus-project.eu/person/person_110> ] ;
    schema:dateCreated "1610-01-21"^^xsd:date ;
    schema:inLanguage "English" ;
    schema:locationCreated [ opus:certainty "certain" ;
            opus:value <https://opus-project.eu/place/place_1> ] .

