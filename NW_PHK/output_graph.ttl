<https://opus-project.eu/letter/Smith1_letter_32> a opus:LetterManifestation,
        schema:CreativeWork ;
    dcterms:abstract "Henry Wotton writes to Lord Zouche regarding political and religious intrigue surrounding Lord Darcy in Rome. Darcy, accused of possessing a controversial book by Jesuit Antonio Possevino, faced scrutiny from the Inquisition. The Grand Duke of Tuscany intervened on his behalf, but fears arose that the book’s reprinting would provoke further reprisals. Additionally, Wotton notes accusations of secret correspondences between French exiles and Cardinal Mendoza, potentially leading to severe consequences. Wotton also updates Zouche on his personal situation, including financial concerns, delays in his journey to Venice, and false rumors of his imprisonment by the Inquisition." ;
    dcterms:subject <https://opus-project.eu/keyword/codenames>,
        <https://opus-project.eu/keyword/conspiracy>,
        <https://opus-project.eu/keyword/false_rumours>,
        <https://opus-project.eu/keyword/politics>,
        <https://opus-project.eu/keyword/religion> ;
    bibo:edition "Pearsall Smith 1907, pp. 350-353" ;
    skos:note "letter_59 in the old chart (Wotton_Jes_Letters) | \"In his previous letter Wotton had enclosed a new cipher in regard to Lord Darcy. This has not been preserved, but it is easy to discover that ‘the Frenchman’ stood for Lord Darcy, ‘Monsieur du Plese’ for the Lord Treasurer, ‘The Master of the Vatican Library’ for the Grand Duke.\" - note by Smith" ;
    opus:authorAsMarked "Henry Wotton" ;
    opus:dateAsMarked "twenty-fifth day of November, 1592" ;
    opus:dateIsUncertain true ;
    opus:hasNameAppearance [ opus:nameAsUsed "Mr. Nevil" ;
            opus:person <https://opus-project.eu/person/person_108> ],
        [ opus:nameAsUsed "the College" ;
