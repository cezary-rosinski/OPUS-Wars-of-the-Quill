<https://opus-project.eu/letter/Smith1_letter_25> a opus:LetterManifestation,
        schema:CreativeWork ;
    dcterms:abstract "This letter, written on July 27th 1592, presents a report by Henry Wotton to Baron Edward La Zouche, detailing the recent affairs in Rome and France from the last week. The author presents the rumours surrounding the possible cardinalship of Archbishop of Pisa, as well as activities of Pope Clement VIII (particularly his general examination of the clergy in the church of St. John Lateran). The letter also touches upon the topic of the French Wars of Religion, mentioning the actions of the Duke of Parma and Duke of Mayn (Mayenne)." ;
    dcterms:subject <https://opus-project.eu/keyword/cardinalship>,
        <https://opus-project.eu/keyword/catholic_league_of_france__holy_league_>,
        <https://opus-project.eu/keyword/catholicism>,
        <https://opus-project.eu/keyword/french_wars_of_religion>,
        <https://opus-project.eu/keyword/international_politics>,
        <https://opus-project.eu/keyword/papacy>,
        <https://opus-project.eu/keyword/politics>,
        <https://opus-project.eu/keyword/protestantism>,
        <https://opus-project.eu/keyword/religion>,
        <https://opus-project.eu/keyword/war> ;
    bibo:edition "Pearsall Smith 1907, pp. 339-340" ;
    opus:authorAsMarked "Henry Wotton" ;
