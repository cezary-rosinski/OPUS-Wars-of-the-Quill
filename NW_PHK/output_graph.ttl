<https://opus-project.eu/letter/Smith1_letter_97> a opus:LetterManifestation,
        schema:CreativeWork ;
    dcterms:abstract "Henry Wotton informs the Earl of Salisbury of the near resolution of the crisis between Venice and the Papacy, with an outcome that he sees as favorable to Venice and to Protestant interests. He recounts a speech he delivered before the Venetian College, in which he praised King James I for his support, asserting that his intervention was crucial to securing Venice’s autonomy in the dispute. Wotton highlights that the Venetian Republic will not use terms such as “rebenediction” or “absolution” to describe the agreement, preferring instead accomodamento (settlement), which maintains their sovereignty. He further notes that the resolution will include a permanent exclusion of the Jesuits from Venetian territories, despite prior efforts to reinstate them. Wotton emphasizes Venice’s deep gratitude to James I and its commitment to preserving its jurisdiction against any future Papal pressures. The letter underscores the complex political maneuvers at play, with Henry IV of France and Spain also involved in shaping the final agreement." ;
    bibo:edition "Pearsall Smith 1907, pp. 476-480" ;
    skos:note "letter_16 in the old chart (Wotton_Jes_Letters)" ;
    opus:authorAsMarked "Henry Wotton" ;
    opus:dateAsMarked "6th of April, 1607. Style of the place." ;
    opus:destination [ opus:certainty "inferred" ;
            opus:value <https://opus-project.eu/place/place_4> ] ;
    opus:destinationAsMarked "London" ;
    opus:incipit "As I advertised his Majesty by the last post," ;
    opus:originAsMarked "Venice" ;
    opus:recipient [ opus:certainty "certain" ;
            opus:value <https://opus-project.eu/person/person_199> ] ;
    opus:recipientAsMarked "Earl of Salisbury" ;
    schema:author [ opus:certainty "certain" ;
            opus:value <https://opus-project.eu/person/person_110> ] ;
    schema:dateCreated "1607-04-06"^^xsd:date ;
    schema:inLanguage "English" ;
    schema:locationCreated [ opus:certainty "certain" ;
            opus:value <https://opus-project.eu/place/place_1> ] .

