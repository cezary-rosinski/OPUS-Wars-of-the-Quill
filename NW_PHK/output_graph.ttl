<https://opus-project.eu/letter/Ulrich1_letter_1> a opus:LetterManifestation,
        schema:CreativeWork ;
    dcterms:abstract "Sarpi expresses his admiration for Thou's Historiæ sui temporis, a copy of which Thou had sent to him. Given the date of the letter, we can infer that Sarpi is referring to the first part of the history, published in 1604. The second part would not be published until 1606." ;
    dcterms:subject <https://opus-project.eu/keyword/historiæ_sui_temporis>,
        <https://opus-project.eu/keyword/history>,
        <https://opus-project.eu/keyword/paris>,
        <https://opus-project.eu/keyword/venice> ;
    opus:authorAsMarked "Sarpi, Paolo" ;
    opus:dateAsMarked "23-Mar-1604" ;
    opus:destinationAsMarked "Paris" ;
    opus:originAsMarked "Venice" ;
    schema:inLanguage "Italian" .

