<https://opus-project.eu/letter/Smith1_letter_34> a opus:LetterManifestation,
        schema:CreativeWork ;
    dcterms:abstract "Wotton reports on political and ecclesiastical matters, particularly the unexpected decision by the Pope not to create new cardinals, despite anticipation. He notes that this primarily affects Father Toledo, who was expected to benefit. He discusses the recent deaths of several cardinals, including Canano and Mondovio, as well as the implications for papal politics. The letter also touches on the travels of two Bavarian princes and their reception at Caprarola, possibly as part of papal maneuvering. There is mention of ongoing shifts within the Grand Duchy of Tuscany, including Don Pietro de’ Medici’s marriage in Spain and Signieur Silvio’s new naval appointment." ;
    dcterms:subject <https://opus-project.eu/keyword/cardinalship>,
        <https://opus-project.eu/keyword/international_politics>,
        <https://opus-project.eu/keyword/papacy>,
        <https://opus-project.eu/keyword/political_marriage>,
        <https://opus-project.eu/keyword/politics> ;
    bibo:edition "Pearsall Smith 1907, pp. 356-358" ;
    skos:note "letter_61 in the old chart (Wotton_Jes_Letters)" ;
    opus:authorAsMarked "H. Wotton" ;
    opus:dateAsMarked "28th of December, 1592." ;
    opus:dateIsUncertain true ;
