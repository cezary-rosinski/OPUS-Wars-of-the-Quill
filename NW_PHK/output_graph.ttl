<https://opus-project.eu/letter/Smith1_letter_123> a opus:LetterManifestation,
        schema:CreativeWork ;
    dcterms:abstract "Writing from Venice on 28 March 1608, Henry Wotton informs the Earl of Salisbury that King James I’s Apologia pro Iuramento Fidelitatis (a defense of the Oath of Allegiance) has arrived and circulated among Venetian leadership. Even before Wotton could present a copy to the Doge formally, the Doge had already received one from England and consulted with a “party” (almost certainly Paolo Sarpi). The book has sparked discussion among “residents and other instruments of state.” Wotton requests more copies of the Apologia and additional Protestant works (referencing a catalog Salisbury sent), hoping to distribute them in Venice for “a great many” who might be receptive. In particular, he wants small–format editions of Bishop John Jewel’s Apology, well–suited for discreet circulation and influencing Venetian opinion. Wotton closes by noting a brewing conflict in Austria between Emperor Rudolf II and his brother Archduke Matthias, stemming from a dispute over religious freedom in Hungary and adjacent regions." ;
    bibo:edition "Pearsall Smith 1907, pp. 523-525" ;
    skos:note "letter_24 in the old chart (Wotton_Jes_Letters)" ;
    opus:authorAsMarked "Henry Wotton" ;
    opus:dateAsMarked "28th of March, 1608." ;
    opus:dateIsUncertain true ;
    opus:destination [ opus:certainty "inferred" ;
            opus:value <https://opus-project.eu/place/place_4> ] ;
    opus:destinationAsMarked "London" ;
    opus:incipit "Having at the present sufficiently troubled your Lordship" ;
    opus:originAsMarked "Venice" ;
    opus:recipient [ opus:certainty "certain" ;
            opus:value <https://opus-project.eu/person/person_199> ] ;
    opus:recipientAsMarked "Earl of Salisbury" ;
    schema:author [ opus:certainty "certain" ;
            opus:value <https://opus-project.eu/person/person_110> ] ;
    schema:dateCreated "1608-03-28"^^xsd:date ;
    schema:inLanguage "English" ;
    schema:locationCreated [ opus:certainty "certain" ;
            opus:value <https://opus-project.eu/place/place_1> ] .

