<https://opus-project.eu/letter/Smith1_letter_57> a opus:LetterManifestation,
        schema:CreativeWork ;
    dcterms:abstract "Henry Wotton writes to Sir Thomas Edmondes, the English ambassador in Brussels, with updates from Venice. He comments on the uncertain state of the papacy, describing the new Pope as financially driven, favoring Spain over France due to monetary considerations. Wotton also reports on the murder of Mr. Arthur Poole in Rome, a mysterious and violent death involving three wounds but leaving valuable possessions untouched, raising suspicions about the nature of the crime. Poole was given an elaborate burial at the Jesuit College under the direction of Cardinal Farnese. The letter closes with Wotton excusing himself from writing in his own hand due to the oppressive heat, dictating the letter instead." ;
    dcterms:subject <https://opus-project.eu/keyword/international_politics>,
        <https://opus-project.eu/keyword/murder>,
        <https://opus-project.eu/keyword/papacy> ;
    bibo:edition "Pearsall Smith 1907, pp. 402-404" ;
    skos:note "letter_41 in the old chart (Wotton_Jes_Letters)" ;
    opus:authorAsMarked "Henry Wotton" ;
    opus:dateAsMarked "8 of July, 1605." ;
    opus:dateIsUncertain true ;
    opus:destination [ opus:certainty "inferred" ;
            opus:value <https://opus-project.eu/place/place_10> ] ;
