<https://opus-project.eu/letter/Smith1_letter_151> a opus:LetterManifestation,
        schema:CreativeWork ;
    dcterms:abstract "This letter reports the reaction of Pope Paul V to the preaching of Fra Fulgenzio Micanzio, which had stirred controversy in Venice. The Venetian ambassador in Rome informed the Duke of Venice that the Pope, after hearing complaints from Cardinal Lanfranco, angrily denounced Fulgenzio’s sermons, asserting that preaching the pure Gospel and Scripture amounted to an attack on the Catholic faith. The Venetian Senate, upon hearing this remark, reacted with murmurs and scandal, perceiving the Pope’s words as proof of the Church’s suppression of biblical teaching. Paolo Sarpi (Padre Paulo), a leading Venetian theologian, saw this as a key moment in exposing Rome’s hostility toward religious reform, believing it would help open the eyes of the Venetian authorities to papal overreach. This letter underscores the widening rift between Venice and Rome, highlighting the Venetian desire for religious independence and the increasing tension over Protestant-leaning reforms within the Republic." ;
    bibo:edition "Pearsall Smith 1907, pp. 572-573" ;
    skos:note "letter_28 in the old chart (Wotton_Jes_Letters)" ;
    opus:dateAsMarked "24th of April, 1609. Style of the place." ;
    opus:destination [ opus:certainty "inferred" ;
            opus:value <https://opus-project.eu/place/place_4> ] ;
    opus:destinationAsMarked "London" ;
    opus:incipit "The resident ambassador of the Signory at Rome" ;
    opus:originAsMarked "Venice" ;
    opus:recipient [ opus:certainty "certain" ;
            opus:value <https://opus-project.eu/person/person_199> ] ;
    opus:recipientAsMarked "Earl of Salisbury" ;
    schema:author [ opus:certainty "inferred" ;
            opus:value <https://opus-project.eu/person/person_110> ] ;
    schema:dateCreated "1609-04-24"^^xsd:date ;
    schema:inLanguage "English" ;
    schema:locationCreated [ opus:certainty "certain" ;
            opus:value <https://opus-project.eu/place/place_1> ] .

<https://opus-project.eu/letter/Smith1_letter_152> a opus:LetterManifestation,
        schema:CreativeWork ;
    bibo:edition "Pearsall Smith 1907, pp. 573-575" ;
    opus:authorAsMarked "Henry Wotton" ;
    opus:dateAsMarked "24th of April, 1609. Style of the place." ;
