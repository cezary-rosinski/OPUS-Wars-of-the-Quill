<https://opus-project.eu/letter/Ulrich1_letter_2> a opus:LetterManifestation,
        schema:CreativeWork ;
    dcterms:abstract "Sarpi ask de Thou if he can help to deliver a copy of the Quran to Isaac Casaubon, who was living in Paris at that time. Sarpi relates that the Quran had been taken as loot some fifty years earlier by Lorenzo Amulio when he had defeated the Turkish corsair Sabbarays." ;
    dcterms:subject <https://opus-project.eu/keyword/agostino_amulio>,
        <https://opus-project.eu/keyword/coran>,
        <https://opus-project.eu/keyword/francesco_maria_sangri>,
        <https://opus-project.eu/keyword/lorenzo_amulio>,
        <https://opus-project.eu/keyword/paris>,
        <https://opus-project.eu/keyword/piracy>,
        <https://opus-project.eu/keyword/quran>,
        <https://opus-project.eu/keyword/sabbarays>,
        <https://opus-project.eu/keyword/turkish>,
        <https://opus-project.eu/keyword/venice> ;
    opus:authorAsMarked "Sarpi, Paolo" ;
    opus:dateAsMarked "31-May-1604" ;
    opus:destinationAsMarked "Paris" ;
    opus:originAsMarked "Venice" ;
    schema:inLanguage "Italian" .

<https://opus-project.eu/letter/Ulrich1_letter_3> a opus:LetterManifestation,
        schema:CreativeWork ;
    dcterms:abstract "Sarpi tells de Thou that the second part of his Historia has been delayed getting to Venice. It is currently in quarantine in Vicentino due to plague worries there. Sarpi offers to give de Thou a careful narration of the tensions between the Pope and Venice for de Thou's use in a subsquent volume of his Historia." ;
    dcterms:subject <https://opus-project.eu/keyword/historiæ_sui_temporis>,
        <https://opus-project.eu/keyword/history>,
        <https://opus-project.eu/keyword/paris>,
        <https://opus-project.eu/keyword/plague>,
        <https://opus-project.eu/keyword/pope>,
        <https://opus-project.eu/keyword/venice>,
        <https://opus-project.eu/keyword/vicentino> ;
    opus:authorAsMarked "Sarpi, Paolo" ;
    opus:dateAsMarked "6-Jun-1607" ;
    opus:destinationAsMarked "Paris" ;
    opus:originAsMarked "Venice" ;
    schema:inLanguage "Italian" .

