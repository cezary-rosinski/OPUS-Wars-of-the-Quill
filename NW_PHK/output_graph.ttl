<https://opus-project.eu/letter/Smith1_letter_71> a opus:LetterManifestation,
        schema:CreativeWork ;
    dcterms:abstract "Henry Wotton writes to the Earl of Salisbury from Venice, reporting the escalating tensions between the Venetian Republic and the Papacy, which seem to be leading to war. He interprets these events as a divine reckoning meant to “purge this country.” Wotton encloses an intercepted letter from Rome, written by Lorenzo Terzo, a Jesuit who had been expelled from Venice. He vows to continue his intelligence-gathering efforts, hoping to uncover Jesuit communications between their colleges and European courts. Wotton expresses his dedication to King James I’s service and prays for Salisbury’s well-being." ;
    dcterms:subject <https://opus-project.eu/keyword/espionage>,
        <https://opus-project.eu/keyword/intercepted_correspondence>,
        <https://opus-project.eu/keyword/international_politics>,
        <https://opus-project.eu/keyword/politics>,
        <https://opus-project.eu/keyword/war> ;
